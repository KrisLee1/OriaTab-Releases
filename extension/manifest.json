{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": { "open-aide": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "__MSG_aide_command_open__" } },
  "permissions": ["storage", "favicon", "contextMenus", "activeTab", "scripting"],
  "optional_permissions": ["bookmarks", "tabs", "tabGroups", "search", "history"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [{ "resources": ["aide.html"], "matches": ["http://*/*", "https://*/*"] }],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline';" }
}
